{
  "name": "clqn",
  "homepage": "https://clqn.org/",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/mcp",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --workspace @clqn/shared --workspace @clqn/mcp && npm run typecheck --workspaces && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --conditions=clqn-source --import tsx --test --test-concurrency=1 packages/*/test/*.test.ts",
    "test:coverage": "node --conditions=clqn-source --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='packages/*/src/**' --test-coverage-lines=88 --test-coverage-branches=82 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info packages/*/test/*.test.ts",
    "dev": "npm run dev --workspace @clqn/api",
    "cli": "node packages/cli/dist/index.js",
    "package:cli": "node scripts/package-cli.mjs",
    "test:package": "node --import tsx --test scripts/package.test.ts",
    "db:generate": "npm run db:generate --workspace @clqn/api",
    "db:migrate": "npm run db:migrate --workspace @clqn/api",
    "db:cleanup": "npm run db:cleanup --workspace @clqn/api",
    "user": "npm run user --workspace @clqn/api --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.6.10",
    "esbuild": "0.28.2",
    "marked": "18.2.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
